{
    "name": "@hodfords/nestjs-cls-translation",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "Provides context-aware translations in NestJS using CLS",
    "main": "./index.js",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "format": "prettier --write \"lib/**/*.ts\"",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "test": "vitest run",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-cls-translation"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-cls-translation/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-cls-translation#readme",
    "dependencies": {
        "nestjs-i18n": "10.8.5"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "express": ">=5.0.0",
        "nestjs-cls": ">=6.0.0"
    },
    "peerDependenciesMeta": {
        "express": {
            "optional": true
        }
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/express": "5.0.6",
        "@types/node": "26.4.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "express": "5.2.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "nestjs-cls": "6.2.2",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "type": "module",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
